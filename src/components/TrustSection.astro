---
// TrustSection.astro - Case Studies Grid
const caseStudies = [
  {
    title: "20-Track Album in 3 Months",
    description: "Produced, mixed, and mastered \"Leon McConnell Twenty Poems\" - building full instrumental soundscapes for his audio recordings. Client said: \"He exceeded my expectations by miles... creating whole worlds for these songs.\""
  },
  {
    title: "Multiple Producers, Customized Beats",
    description: "Produced 2 of the beats. Added instrumentation to 3 of the 7 tracks for Struggle Crew. Mix and master exceeded expectations. \"You took a simple small thing and brought it to life. I can't pay you enough for that. I see all the love for music you pour into it. I'm wowed.\""
  },
  {
    title: "5-Song EP From Scratch",
    description: "Delivered a complete EP for Dirty Chai - beats, mixing, mastering, and additional vocals from Holly Cole. Mixed and pitch-corrected 14 vocal tracks for Voodoo Bed's title song - blending freestyle ad-libs and backup vocals into a seamless final master."
  },
  {
    title: "10 Track 100% Live Instrument Album",
    description: "Fully recorded and produced \"True Love Story\" by Jenny. Sourced live drums, professionally mic'd, live bass & guitar, vocals recorded on AT 4050."
  }
];
---

<section class="trust-section section">
  <div class="container">
    <div class="trust-grid">
      {caseStudies.map((study) => (
        <div class="trust-card glass">
          <h3 class="trust-title">{study.title}</h3>
          <p class="trust-description">{study.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .trust-card {
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: left;
    transition: all var(--transition-base);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .trust-card:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
      0 8px 32px rgba(0, 0, 0, 0.35);
  }

  .trust-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
  }

  .trust-description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: 0;
    line-height: 1.6;
  }

  /* Responsive Grid Layout */
  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .trust-section {
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
    }

    .trust-grid {
      gap: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .trust-card {
      padding: var(--space-10);
    }
  }
</style>
