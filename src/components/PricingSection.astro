---
// PricingSection.astro - Pricing tiers for beat leases and exclusive rights
---

<section id="pricing" class="section pricing-section">
  <div class="container">
    <div class="section-header">
      <h2>Simple, Transparent Pricing</h2>
      <p class="section-description">Choose the license that fits your project</p>
    </div>

    <div class="pricing-grid">
      <!-- MP3 -->
      <div class="pricing-card glass">
        <div class="pricing-header">
          <h3 class="tier-name">MP3</h3>
          <div class="price">
            <span class="price-amount">$50</span>
          </div>
        </div>

        <div class="format-badge">
          <span class="format-text">320 kbps</span>
        </div>

        <ul class="features-list">
          <li class="feature-item">Mp3 File</li>
          <li class="feature-item">Structure As-Is</li>
          <li class="feature-item">Non-Exclusive License</li>
          <li class="feature-item">Sell 5k Copies</li>
          <li class="feature-item">10k Streams</li>
          <li class="feature-item">Bundle Discounts</li>
        </ul>

        <a href="#contact" class="btn btn-secondary select-btn">View License</a>
      </div>

      <!-- WAV - MOST POPULAR -->
      <div class="pricing-card glass highlight">
        <div class="popular-badge">Most Popular</div>

        <div class="pricing-header">
          <h3 class="tier-name">WAV</h3>
          <div class="price">
            <span class="price-amount">$80</span>
          </div>
        </div>

        <div class="format-badge">
          <span class="format-text">24 bit 48 kHz</span>
        </div>

        <ul class="features-list">
          <li class="feature-item">Wav File</li>
          <li class="feature-item">1 Structure Edit</li>
          <li class="feature-item">Non-Exclusive License</li>
          <li class="feature-item">Sell 10k Copies</li>
          <li class="feature-item">100k Streams</li>
          <li class="feature-item">Bundle Discounts</li>
        </ul>

        <a href="#contact" class="btn btn-primary select-btn">View License</a>
      </div>

      <!-- STEMS -->
      <div class="pricing-card glass">
        <div class="pricing-header">
          <h3 class="tier-name">STEMS</h3>
          <div class="price">
            <span class="price-amount">$249</span>
          </div>
        </div>

        <div class="format-badge">
          <span class="format-text">24 bit 48 kHz</span>
        </div>

        <ul class="features-list">
          <li class="feature-item">Wav Stems</li>
          <li class="feature-item">Infinite Edits</li>
          <li class="feature-item">Non-Exclusive License</li>
          <li class="feature-item">Sell 20k Copies</li>
          <li class="feature-item">250k Streams</li>
          <li class="feature-item">Discount on Mix & Master</li>
        </ul>

        <a href="#contact" class="btn btn-secondary select-btn">View License</a>
      </div>

      <!-- EXCLUSIVE -->
      <div class="pricing-card glass">
        <div class="pricing-header">
          <h3 class="tier-name">EXCLUSIVE</h3>
          <div class="price">
            <span class="price-amount">$2k</span>
          </div>
        </div>

        <div class="format-badge">
          <span class="format-text">You get it all</span>
        </div>

        <ul class="features-list">
          <li class="feature-item">All Wav Stems</li>
          <li class="feature-item">Infinite Edits</li>
          <li class="feature-item">Exclusive License</li>
          <li class="feature-item">Sell Unlimited Copies</li>
          <li class="feature-item">Unlimited Streams</li>
          <li class="feature-item">Discount on Mix & Master</li>
        </ul>

        <a href="#contact" class="btn btn-secondary select-btn">View License</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .section-header h2 {
    margin-bottom: var(--space-4);
  }

  .section-description {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-size: var(--text-lg);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pricing-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
    }
  }

  .pricing-card {
    position: relative;
    padding: var(--space-8);
    border-radius: var(--radius-xl);

    /* Teal borders for pricing cards */
    border: 1.5px solid var(--pricing-border);

    display: flex;
    flex-direction: column;
    gap: var(--space-6);

    transition: all var(--transition-base);
  }

  .pricing-card:hover {
    border-color: var(--pricing-hover-border);
    box-shadow: var(--pricing-glow);
    transform: translateY(-4px);
  }

  /* Highlighted card (WAV Lease) */
  .pricing-card.highlight {
    border-color: var(--pricing-highlight-border);
    box-shadow: var(--pricing-glow);
  }

  .pricing-card.highlight:hover {
    box-shadow: 0 0 28px rgba(11, 77, 90, 0.6);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);

    padding: var(--space-2) var(--space-4);

    background: linear-gradient(135deg, var(--color-teal), var(--color-teal-hover));
    color: var(--color-black);

    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;

    border-radius: var(--radius-full);
    box-shadow: 0 4px 12px rgba(45, 212, 191, 0.3);
  }

  .pricing-header {
    text-align: center;
  }

  .tier-name {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  .price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-1);
  }

  .price-amount {
    font-size: var(--text-5xl);
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--color-teal);
    line-height: 1;
  }

  .price-suffix {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-teal);
  }

  .format-badge {
    text-align: center;
    padding: var(--space-2) var(--space-4);
    background: rgba(45, 212, 191, 0.1);
    border: 1px solid rgba(45, 212, 191, 0.3);
    border-radius: var(--radius-md);
  }

  .format-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-teal);
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-grow: 1;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    position: relative;
    padding-left: var(--space-6);
  }

  .feature-item::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .select-btn {
    width: 100%;
    margin-top: auto;
  }

  /* Mobile optimization */
  @media (max-width: 639px) {
    .pricing-card {
      padding: var(--space-6);
    }

    .tier-name {
      font-size: var(--text-xl);
    }

    .price-amount {
      font-size: var(--text-4xl);
    }
  }
</style>
