---
// ServicesGrid.astro - Professional Services Grid
const services = [
  {
    title: "Mix & Master",
    pricing: "$350 ea/ $50hr",
    details: [
      "Pricing depends on scope of project",
      "Request Google Drive link for uploading wavs",
      "Upload audio in wav format with -6db headroom",
      "We'll have a convo about your vision for best results"
    ],
    icon: "🎛️"
  },
  {
    title: "Custom Tracks",
    pricing: "$300-$500",
    details: [
      "Creating music for an existing recording",
      "Music for spoken word, mixtape, podcast, intros",
      "Cost depends on the project. Reach out for a quote",
      "We'll discuss your vision & upload existing files"
    ],
    icon: "🎹"
  },
  {
    title: "Instrumentals",
    pricing: "$50-$2k",
    details: [
      "See pricing above, and details on the Services page",
      "Head to the Beats page to shop for instrumentals",
      "Exclusive and Non-Exclusive licensing options",
      "Bundle discounts & coupon codes for subscribers"
    ],
    icon: "💿"
  },
  {
    title: "Studio Time",
    pricing: "$50/hr",
    details: [
      "Record vocals, instrumentals, acoustic sets",
      "Access to terabytes of samples and instruments",
      "Professionally sound treated studio & plenty of gear",
      "Recording equipment & software for video content"
    ],
    icon: "🎙️"
  },
  {
    title: "Female & Male Vox",
    pricing: "$100-$200",
    details: [
      "Price difference based on prewritten vs custom",
      "For female vox examples, see \"Seed\" & \"Sloth\"",
      "Female & Male vox textures and samples, beat tags",
      "Recordings bounced in wav format, dry or wet"
    ],
    icon: "🎤"
  },
  {
    title: "DJ For Your Event",
    pricing: "$500-$2000/ $150/hr",
    details: [
      "Laptop, PA system, mixer, microphones, lighting",
      "MC, help with structure, sound checks all planned",
      "If event planning is needed, I partner with a planner",
      "Playlists ready to go, uploading site for your picks"
    ],
    icon: "🎧"
  }
];
---

<section class="services-section section">
  <div class="container">
    <div class="services-header">
      <h2 class="services-title">Services</h2>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card glass">
          <div class="service-icon" aria-hidden="true">{service.icon}</div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-pricing">{service.pricing}</p>
          <ul class="service-details">
            {service.details.map((detail) => (
              <li class="detail-item">{detail}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .services-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .services-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .services-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .service-card {
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-teal) 0%, var(--color-teal-hover) 100%);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1),
      0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-icon {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .service-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
  }

  .service-pricing {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-teal);
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
  }

  .service-details {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .detail-item {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: var(--space-6);
    position: relative;
  }

  .detail-item::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-teal);
    font-weight: 700;
    font-size: var(--text-base);
  }

  /* Responsive Grid Layout */
  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 768px) {
    .services-section {
      padding-top: var(--space-20);
      padding-bottom: var(--space-20);
    }

    .services-header {
      margin-bottom: var(--space-16);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .service-card {
      padding: var(--space-10);
    }
  }

  @media (max-width: 639px) {
    .services-title {
      font-size: var(--text-3xl);
    }

    .service-title {
      font-size: var(--text-xl);
    }
  }
</style>
